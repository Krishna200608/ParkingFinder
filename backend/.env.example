# Server Port
PORT=5001

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/parkingfinder
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/parkingfinder
MONGO_URI=mongodb://localhost:27017/parkingfinder

# JWT Secret Key for Signing Authentication Tokens
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Node Environment ('development' or 'production')
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:3000

# Razorpay Test Credentials (Optional: Leave blank to use Free Student Simulation Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

