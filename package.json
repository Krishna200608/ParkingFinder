{
  "name": "parkingfinder-root",
  "version": "1.0.0",
  "description": "Root for ParkingFinder MERN project",
  "main": "api/index.js",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix backend",
    "client": "npm start --prefix frontend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "Krishna",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
