# ==============================================================================
# ParkingFinder — Root Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Database (Required)
# ------------------------------------------------------------------------------
PORT=5001
MONGO_URI=mongodb://localhost:27017/parkingfinder
JWT_SECRET=your_super_secret_jwt_key_change_in_production
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Resend Transactional Email Service (Optional - Free Tier: 100 emails/day)
# https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=ParkingFinder <notifications@parkingfinder.dev>

# ------------------------------------------------------------------------------
# 3. Pusher Channels Real-Time Availability (Optional - Free Tier: 200k msgs/day)
# https://pusher.com
# ------------------------------------------------------------------------------
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap2

# ------------------------------------------------------------------------------
# 4. Stripe Payment Gateway (Optional - Test Mode Sandbox fallback if omitted)
# https://dashboard.stripe.com/test/apikeys
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 5. Sentry Exception Monitoring & Observability (Optional - Free Tier: 5k/mo)
# https://sentry.io
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your_public_key@sentry.io/your_project_id

# ------------------------------------------------------------------------------
# 6. Vercel Cron Security Secret (Optional for local dev, Recommended on Vercel)
# ------------------------------------------------------------------------------
CRON_SECRET=your_random_32_character_cron_secret
